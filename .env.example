# Server runtime
NODE_ENV=production
PORT=3001
DB_PATH=./apps/server/data/remote_control.db

# Required authentication values (never commit real values)
OPERATOR_USERNAME=replace-me
OPERATOR_PASSWORD_HASH=replace-with-bcrypt-hash
JWT_SECRET=replace-with-at-least-32-random-bytes

# Comma-separated browser origins allowed to use HTTP and Socket.IO
CORS_ORIGINS=https://control.example.com

# Public repository containing the exact source for the deployed version
SOURCE_CODE_URL=https://github.com/feloxd/remote-control-app

# Desktop development overrides (set in the launching shell when needed)
# SERVER_URL=https://control.example.com
# CENSOR_MODEL_PATH=C:\absolute\path\to\nudenet-320n.onnx

# SSH maintenance script (set in the shell; do not store real values here)
# SSH_HOST=server.example.com
# SSH_USER=root
# SSH_PASSWORD=replace-me
# SSH_PUBLIC_KEY=ssh-ed25519 replace-me
